// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}







// ၁။ Dynamic Event Structure
model Event {
  id            String         @id @default(cuid())
  title         String         // ဥပမာ - "Tech Summit 2026"
  slug          String         @unique // URL Dynamic Routing အတွက် (ဥပမာ - tech-summit-2026)
  description   String?
  eventDate     DateTime
  location      String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // 1-to-Many Relationship
  registrations Registration[]

  @@index([slug])
  @@index([isActive])
}

// ၂။ Dynamic Registrations Structure
model Registration {
  id        String   @id @default(cuid())
  
  // Foreign Key - ဘယ် Event အောက်က Data လဲဆိုတာ ခွဲခြားရန်
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // User/Attendee Data Fields
  fullName  String
  email     String
  phone     String
   age      Int
   address  String

  // Offline-First Tracking
  // Dexie.js (Offline DB) မှ Sync လုပ်လာသော Data ဟုတ်မဟုတ် မှတ်သားရန်
  isOfflineSynced Boolean  @default(false)

  // Idempotency Key - UUID generated on client before Dexie save.
  // This prevents duplicate registrations when both SW Background Sync
  // and client-side sync attempt to send the same data simultaneously.
  syncId String? @unique
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Performance Optimization မရှိမဖြစ် Indexes များ
  @@index([eventId])
  @@index([email])
  @@index([createdAt])
  @@index([syncId])
  // DB-level unique constraint: prevents same email for same event
  @@unique([eventId, email])
}
