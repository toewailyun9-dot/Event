// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}







// ၁။ Dynamic Event Structure
model Event {
  id            String         @id @default(cuid())
  title         String         // ဥပမာ - "Tech Summit 2026"
  description   String?
  eventDate     DateTime
  location      String?
  // Event အတွက် Telegram / Viber Group Invite Link များ
  // (Registration အောင်မြင်သည့် success page တွင် ပြသရန်)
  telegramLink  String?
  viberLink     String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // 1-to-Many Relationship
  registrations Registration[]
  emailMessages EmailMessage[]
  sponsors EventSponsor[]

  @@index([isActive])
}

// ၂။ Dynamic Registrations Structure
model Registration {
  id        String   @id @default(cuid())
  
  // Foreign Key - ဘယ် Event အောက်က Data လဲဆိုတာ ခွဲခြားရန်
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // User/Attendee Data Fields
  fullName  String
  email     String
  phone     String
  age      Int
  address  String

  // Idempotency Key - UUID generated on client before Dexie save.
  // This prevents duplicate registrations when both SW Background Sync
  // and client-side sync attempt to send the same data simultaneously.
  syncId String? @unique
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Performance Optimization မရှိမဖြစ် Indexes များ
  @@index([eventId])
  @@index([email])
  @@index([createdAt])
  @@index([eventId, createdAt])
  @@index([syncId])
  // DB-level unique constraint: prevents same email for same event
  @@unique([eventId, email])
}

// ၃။ Email Messaging (Outbox pattern)
enum EmailStatus {
  PENDING
  SENT
  FAILED
}

// One row per recipient — the outbox that the cron worker drains.
model EmailMessage {
  id         String      @id @default(cuid())
  eventId    String?
  event      Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  // Snapshot of the event at send time — used to personalize {eventTitle}
  // and {eventDate} even if the event is later deleted.
  eventTitle String?
  eventDate  DateTime?
  to         String
  name       String?
  subject    String
  body       String
  status     EmailStatus @default(PENDING)
  attempts   Int         @default(0)
  lastError  String?
  sentAt     DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status])
  @@index([eventId])
  @@index([to])
  @@index([createdAt])
  @@index([status, createdAt])
}

// Emails that opted out — never send to these again.
model UnsubscribedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([email])
}

// Sponsoring Company (reusable across multiple events)
model Sponsor {
  id           String   @id @default(cuid())
  name         String
  website      String?
  description  String?
  contactEmail String?
  contactName  String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events EventSponsor[]
}

// Event ↔ Sponsor join (per-event sponsorship details)
model EventSponsor {
  id        String   @id @default(cuid())
  eventId   String
  sponsorId String
  amount    Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sponsor Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@unique([eventId, sponsorId])
  @@index([eventId])
  @@index([sponsorId])
}
